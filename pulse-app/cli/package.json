    "src/personal-install-command.js",
    "src/personal-install.js",
    "src/personal-host-adapters.js",
    "src/personal-live-readiness.js",
    "src/personal-principal.js",
    "src/personal-runtime-installer.js",
    "src/release-manifest.js",
    "src/supported-hosts.js",
    "src/managed-embedder-release.js",
    "src/managed-embedder-download.js",
    "src/demo-corpus.json",
    "scripts",
    "runtime",
    "vendor/pulse-preview-source",
    "vendor/pulse-mcp-dist",
    "vendor/pulse-presence-helper",
    "release",
    "README.md",
    "LICENSE"
  ],
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.4.0"
  },
  "scripts": {
    "check": "node src/cli.js --help",
    "test": "node --test --test-concurrency=1 src/*.test.js",
    "test:codex-product": "node scripts/codex-product-e2e.mjs",
    "test:personal-clean-room": "node scripts/personal-preview-clean-room.mjs",
    "test:personal-interruption": "node scripts/personal-preview-interruption-e2e.mjs",
    "test:personal-multiharness": "node scripts/personal-preview-multiharness-e2e.mjs",
    "attest:personal-preview": "node scripts/personal-preview-release-attestation.mjs",
    "test:git-team-memory": "node scripts/git-team-memory-e2e.mjs",
    "test:codex-product:real-mlx": "PULSE_CODEX_E2E_REQUIRE_REAL_MLX=1 node scripts/codex-product-e2e.mjs",
    "test:codex-team-packaging-contract": "node scripts/codex-team-packaging-contract.mjs",
    "test:claude-product": "node scripts/claude-product-e2e.mjs",
    "build:presence-helper": "node scripts/build-presence-helper.mjs",
    "build:embedder-runtime": "node scripts/build-embedder-runtime.mjs",
    "build:personal-release": "node scripts/build-personal-release.mjs",
    "sign:release-manifest": "node scripts/sign-release-manifest.mjs",
    "prepack": "node scripts/prepare-preview-vendor.mjs",
    "prepublishOnly": "cd ../.. && make release-verify && cd pulse-app/cli && node scripts/prepare-preview-vendor.mjs"
  },
  "engines": {
    "node": ">=20"
  },
  "keywords": [
    "pulse",
    "ai-agents",
    "memory",
    "ai-memory",
    "agent-memory",
    "mcp",
    "model-context-protocol",
    "claude-code",
    "anthropic",
    "llm",
    "rag",
    "retrieval",
    "knowledge-graph",
    "state-aware",
    "embeddings",
    "continuity",
    "local-first",
    "host-extracted",
    "portable-memory"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/zbs-gg/pulse.git",
    "directory": "cli"
  },
  "bugs": {
    "url": "https://github.com/zbs-gg/pulse/issues"
  },
  "homepage": "https://github.com/zbs-gg/pulse#readme",
  "publishConfig": {
    "access": "public"
  }
