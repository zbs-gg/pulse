{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://zbs.gg/schemas/pulse/personal-release-artifact-set.v1.json",
  "title": "Pulse Personal immutable release artifact set",
  "type": "object",
  "additionalProperties": false,
  "required": ["payload", "schema", "signature"],
  "properties": {
    "schema": { "const": "pulse.personal_release_artifact_set.v1" },
    "payload": {
      "type": "object",
      "additionalProperties": false,
      "required": ["allowed_origins", "common_artifacts", "host_policy", "release", "schema", "snapshot_url", "targets"],
      "properties": {
        "schema": { "const": "pulse.personal_release_artifact_set_payload.v1" },
        "allowed_origins": { "type": "array", "minItems": 1, "maxItems": 8, "uniqueItems": true, "items": { "type": "string", "pattern": "^https://" } },
        "common_artifacts": { "type": "object" },
        "host_policy": {
          "type": "object",
          "additionalProperties": false,
          "required": ["harnesses"],
          "properties": {
            "harnesses": {
              "type": "array",
              "minItems": 4,
              "maxItems": 4,
              "items": {
                "type": "object",
                "additionalProperties": false,
                "required": ["distribution", "downloads", "executable", "executable_digest_policy", "host", "identity", "supported_targets", "vendor", "vendor_source", "version"],
                "properties": {
                  "distribution": { "enum": ["npm", "vendor-desktop-installer"] },
                  "downloads": { "type": "object", "minProperties": 1, "maxProperties": 6, "additionalProperties": { "type": "string", "pattern": "^https://" } },
                  "executable": { "type": "string" },
                  "executable_digest_policy": { "const": "native_evidence_sha256" },
                  "host": { "enum": ["claude-code", "codex", "cursor", "opencode"] },
                  "identity": { "type": "string" },
                  "supported_targets": { "type": "array", "minItems": 1, "maxItems": 6, "uniqueItems": true, "items": { "type": "string" } },
                  "vendor": { "type": "string" },
                  "vendor_source": { "type": "string", "pattern": "^https://" },
                  "version": { "type": "string" }
                }
              }
            }
          }
        },
        "release": {
          "type": "object",
          "additionalProperties": false,
          "required": ["channel", "epoch", "key_id", "package", "version"],
          "properties": {
            "channel": { "const": "preview" },
            "epoch": { "type": "integer", "minimum": 1 },
            "key_id": { "type": "string", "pattern": "^[a-f0-9]{64}$" },
            "package": { "const": "@zbs-gg/pulse" },
            "version": { "type": "string" }
          }
        },
        "snapshot_url": { "type": "string", "pattern": "^https://.*/snapshot\\.json$" },
        "targets": { "type": "object", "minProperties": 6, "maxProperties": 6 }
      }
    },
    "signature": { "$ref": "#/$defs/signature" }
  },
  "$defs": {
    "signature": {
      "type": "object",
      "additionalProperties": false,
      "required": ["algorithm", "key_id", "value"],
      "properties": {
        "algorithm": { "const": "ed25519" },
        "key_id": { "type": "string", "pattern": "^[a-f0-9]{64}$" },
        "value": { "type": "string" }
      }
    }
  }
}
