{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://zbs.gg/schemas/pulse/personal-preview-release-catalog.v2.json",
  "title": "Pulse Personal Preview signed desktop release catalog",
  "type": "object",
  "additionalProperties": false,
  "required": ["allowed_origins", "common_artifacts", "release", "schema", "targets"],
  "properties": {
    "schema": { "const": "pulse.personal_preview.release_catalog.v2" },
    "allowed_origins": {
      "type": "array",
      "minItems": 1,
      "maxItems": 8,
      "uniqueItems": true,
      "items": { "type": "string", "format": "uri", "pattern": "^https://" }
    },
    "release": {
      "type": "object",
      "additionalProperties": false,
      "required": ["channel", "epoch", "expires_at", "issued_at", "key_id", "package", "version"],
      "properties": {
        "channel": { "const": "preview" },
        "epoch": { "type": "integer", "minimum": 1 },
        "expires_at": { "type": "string", "format": "date-time" },
        "issued_at": { "type": "string", "format": "date-time" },
        "key_id": { "type": "string", "pattern": "^[a-f0-9]{64}$" },
        "package": { "const": "@zbs-gg/pulse" },
        "version": { "type": "string", "pattern": "^(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)(-[0-9A-Za-z.-]+)?$" }
      }
    },
    "common_artifacts": {
      "type": "object",
      "additionalProperties": false,
      "required": ["model", "plugin-runtime"],
      "properties": {
        "model": { "$ref": "#/$defs/artifact" },
        "plugin-runtime": { "$ref": "#/$defs/artifact" }
      }
    },
    "targets": {
      "type": "object",
      "additionalProperties": false,
      "propertyNames": {
        "enum": ["darwin-arm64", "darwin-x64", "linux-arm64-gnu", "linux-x64-gnu", "win32-arm64", "win32-x64"]
      },
      "patternProperties": {
        "^(darwin-(arm64|x64)|linux-(arm64|x64)-gnu|win32-(arm64|x64))$": { "$ref": "#/$defs/target" }
      }
    }
  },
  "$defs": {
    "target": {
      "type": "object",
      "additionalProperties": false,
      "required": ["architecture", "artifacts", "capabilities", "libc", "platform"],
      "properties": {
        "architecture": { "enum": ["arm64", "x64"] },
        "artifacts": {
          "type": "object",
          "additionalProperties": false,
          "required": ["daemon", "embedder-runtime"],
          "properties": {
            "daemon": { "$ref": "#/$defs/artifact" },
            "embedder-runtime": { "$ref": "#/$defs/artifact" },
            "presence-helper": { "$ref": "#/$defs/artifact" }
          }
        },
        "capabilities": {
          "type": "array",
          "maxItems": 16,
          "uniqueItems": true,
          "items": { "type": "string", "pattern": "^[a-z0-9][a-z0-9._-]{0,127}$" }
        },
        "libc": { "enum": ["gnu", null] },
        "platform": { "enum": ["darwin", "linux", "win32"] }
      }
    },
    "artifact": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "architecture", "bytes", "epoch", "executable", "format", "id", "kind", "minimum_os",
        "model_policy", "origin", "platform", "sha256", "signing", "url", "version"
      ],
      "properties": {
        "architecture": { "enum": ["all", "arm64", "x64"] },
        "bytes": { "type": "integer", "minimum": 1, "maximum": 68719476736 },
        "epoch": { "type": "integer", "minimum": 1 },
        "executable": { "type": "boolean" },
        "format": { "enum": ["dmg", "safetensors", "tar.gz"] },
        "id": { "type": "string", "pattern": "^[a-z0-9][a-z0-9._-]{0,127}$" },
        "kind": { "enum": ["daemon", "embedder-runtime", "model", "plugin-runtime", "presence-helper"] },
        "minimum_os": { "type": "string", "pattern": "^[0-9]+\\.[0-9]+$" },
        "model_policy": {
          "oneOf": [
            { "type": "null" },
            {
              "type": "object",
              "additionalProperties": false,
              "required": ["custom_code", "data_only"],
              "properties": { "custom_code": { "const": false }, "data_only": { "const": true } }
            }
          ]
        },
        "origin": { "type": "string", "format": "uri", "pattern": "^https://" },
        "platform": { "enum": ["all", "darwin", "linux", "win32"] },
        "sha256": { "type": "string", "pattern": "^[a-f0-9]{64}$" },
        "signing": {
          "type": "object",
          "additionalProperties": false,
          "required": ["gatekeeper", "identifier", "notarized", "scheme", "stapled", "team_id"],
          "properties": {
            "gatekeeper": { "type": "boolean" },
            "identifier": { "type": ["string", "null"] },
            "notarized": { "type": "boolean" },
            "scheme": { "enum": ["apple-developer-id", "release-manifest"] },
            "stapled": { "type": "boolean" },
            "team_id": { "type": ["string", "null"] }
          }
        },
        "url": { "type": "string", "format": "uri", "pattern": "^https://" },
        "version": { "type": "string" }
      }
    }
  }
}
