{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "additionalProperties": false,
  "required": ["reasoning", "label"],
  "properties": {
    "reasoning": {
      "type": "string",
      "minLength": 1,
      "maxLength": 2048
    },
    "label": {
      "enum": ["CORRECT", "WRONG", "PASS", "FAIL"]
    }
  }
}
