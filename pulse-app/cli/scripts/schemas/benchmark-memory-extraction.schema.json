{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "additionalProperties": false,
  "required": ["memories"],
  "properties": {
    "memories": {
      "type": "array",
      "maxItems": 256,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["kind", "summary", "source_ids"],
        "properties": {
          "kind": {
            "enum": ["fact", "preference", "event", "decision", "correction", "open_question", "project_state"]
          },
          "summary": {
            "type": "string",
            "minLength": 1,
            "maxLength": 400
          },
          "source_ids": {
            "type": "array",
            "minItems": 1,
            "maxItems": 12,
            "items": {
              "type": "string",
            "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]{0,127}$"
            }
          }
        }
      }
    }
  }
}
