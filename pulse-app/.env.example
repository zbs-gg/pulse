# Pulse — environment variables for docker-compose
#
# Copy to .env and fill in the keys you have. None are strictly required to
# start the server; without an embedding key Pulse runs in retrieval-only
# mode on previously-ingested data.
#
#   cp .env.example .env
#   docker compose up

# Cohere embed-v4.0 — recommended for empathic retrieval evaluation
# https://dashboard.cohere.com/api-keys
COHERE_API_KEY=

# OpenAI — for text-embedding-3-small/large alternatives + GPT-based extraction
# https://platform.openai.com/api-keys
OPENAI_API_KEY=

# Anthropic — for Claude-based extraction/reflection (Pulse's optional layers)
# https://console.anthropic.com/settings/keys
ANTHROPIC_API_KEY=

# CORS — comma-separated origins allowed to call Pulse directly
PULSE_CORS_ORIGINS=http://localhost:5173,http://localhost:3000,http://localhost:8080

# Local embedding (advanced, skip for first-run)
# PULSE_LOCAL_EMBED_PYTHON=/usr/bin/python3
# PULSE_LOCAL_EMBED_HELPER=/app/scripts/embed_helper.py
# PULSE_LOCAL_EMBED_MODEL=BAAI/bge-m3
