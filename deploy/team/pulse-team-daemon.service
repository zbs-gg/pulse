[Unit]
Description=Pulse Team daemon (synthetic-only, loopback)
Documentation=https://github.com/zbs-gg/pulse/blob/main/deploy/team/README.md
After=local-fs.target
ConditionPathExists=/etc/pulse-team/gates/enable-synthetic-runtime
ConditionPathExists=!/etc/pulse-team/gates/allow-external
ConditionPathExists=!/etc/pulse-team/gates/allow-team-read
ConditionPathExists=!/etc/pulse-team/gates/allow-publication
ConditionPathExists=!/etc/pulse-team/gates/allow-real-content

[Service]
Type=simple
User=pulse-team-daemon
Group=pulse-team-daemon
UMask=0077

EnvironmentFile=/etc/pulse-team/daemon.env
LoadCredential=principal-verify-keyring.json:/etc/pulse-team/secrets/principal-verify-keyring.json
Environment=PULSE_RUNTIME_MODE=team-remote
Environment=PULSE_TEAM_PRINCIPAL_VERIFY_KEYRING_FILE=%d/principal-verify-keyring.json

ExecStart=/opt/pulse-team/current/pulse -data-dir /var/lib/pulse-team-daemon -addr 127.0.0.1:18789
Restart=on-failure
RestartSec=5s
TimeoutStopSec=20s
KillSignal=SIGTERM

StateDirectory=pulse-team-daemon
StateDirectoryMode=0700
RuntimeDirectory=pulse-team-daemon
RuntimeDirectoryMode=0700

NoNewPrivileges=yes
PrivateDevices=yes
PrivateTmp=yes
ProtectClock=yes
ProtectControlGroups=yes
ProtectHome=yes
ProtectHostname=yes
ProtectKernelLogs=yes
ProtectKernelModules=yes
ProtectKernelTunables=yes
ProtectSystem=strict
RestrictAddressFamilies=AF_UNIX AF_INET AF_INET6
RestrictNamespaces=yes
RestrictRealtime=yes
LockPersonality=yes
ReadWritePaths=/var/lib/pulse-team-daemon
InaccessiblePaths=-/var/lib/pulse-team-gateway
InaccessiblePaths=-/etc/pulse-team/secrets/gateway-principal-signing-key.pem

[Install]
WantedBy=multi-user.target
