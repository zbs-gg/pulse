[Unit]
Description=Pulse Team MCP gateway (synthetic-only, loopback)
Documentation=https://github.com/zbs-gg/pulse/blob/main/deploy/team/README.md
Requires=pulse-team-daemon.service
After=network-online.target pulse-team-daemon.service
Wants=network-online.target
ConditionPathExists=/etc/pulse-team/gates/enable-synthetic-runtime
ConditionPathExists=!/etc/pulse-team/gates/allow-external
ConditionPathExists=!/etc/pulse-team/gates/allow-team-read
ConditionPathExists=!/etc/pulse-team/gates/allow-publication
ConditionPathExists=!/etc/pulse-team/gates/allow-real-content

[Service]
Type=simple
User=pulse-team-gateway
Group=pulse-team-gateway
UMask=0077

EnvironmentFile=/etc/pulse-team/gateway.env
LoadCredential=secret.key:/var/lib/pulse-team-daemon/secret.key
LoadCredential=principal-signing-key.pem:/etc/pulse-team/secrets/gateway-principal-signing-key.pem
LoadCredential=principal-verify-keyring.json:/etc/pulse-team/secrets/principal-verify-keyring.json
Environment=PULSE_RUNTIME_MODE=team-remote
Environment=PULSE_MCP_MODE=daemon
Environment=PULSE_DATA_DIR=%d
Environment=PULSE_TEAM_PRINCIPAL_SIGNING_KEY_FILE=%d/principal-signing-key.pem
Environment=PULSE_TEAM_PRINCIPAL_VERIFY_KEYRING_FILE=%d/principal-verify-keyring.json

ExecStart=/usr/bin/node /opt/pulse-team/current/mcp/dist/index.js --http --host 127.0.0.1 --port 8787
Restart=on-failure
RestartSec=5s
TimeoutStopSec=15s
KillSignal=SIGTERM

StateDirectory=pulse-team-gateway
StateDirectoryMode=0700
RuntimeDirectory=pulse-team-gateway
RuntimeDirectoryMode=0700

NoNewPrivileges=yes
PrivateDevices=yes
PrivateTmp=yes
ProtectClock=yes
ProtectControlGroups=yes
ProtectHome=yes
ProtectHostname=yes
ProtectKernelLogs=yes
ProtectKernelModules=yes
ProtectKernelTunables=yes
ProtectSystem=strict
RestrictAddressFamilies=AF_UNIX AF_INET AF_INET6
RestrictNamespaces=yes
RestrictRealtime=yes
LockPersonality=yes
ReadWritePaths=/var/lib/pulse-team-gateway
InaccessiblePaths=-/var/lib/pulse-team-daemon

[Install]
WantedBy=multi-user.target
