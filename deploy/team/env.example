# Copy only the relevant section into the named root-owned file. This example
# contains identifiers and placeholders only. Never put tokens, IPC keys,
# private keys, client secrets, transcripts, prompts, or real content here.

# ---------------------------------------------------------------------------
# /etc/pulse-team/daemon.env (0640 root:pulse-team-daemon)
# ---------------------------------------------------------------------------

# Exact immutable Owner bootstrap identity. For Auth0, issuer includes the
# trailing slash and subject is the exact `sub` from the approved Owner token.
PULSE_TEAM_BOOTSTRAP_ISSUER=https://YOUR_AUTH0_TENANT.auth0.com/
PULSE_TEAM_BOOTSTRAP_SUBJECT=AUTH0_OWNER_SUBJECT_PLACEHOLDER
PULSE_TEAM_BOOTSTRAP_ADMIN_CLIENT_ID=AUTH0_OWNER_ADMIN_CLIENT_ID_PLACEHOLDER

# Pin these after the approved bootstrap response. Never infer or reuse IDs
# from a Personal/Desk store.
PULSE_TEAM_EXPECTED_STORE_ID=store_SYNTHETIC_PLACEHOLDER
PULSE_TEAM_EXPECTED_TEAM_ID=team_SYNTHETIC_PLACEHOLDER

# Team retrieval must use a separately provisioned Team dependency. This
# example selects Cohere by file path; install the key as a mode-0600 regular
# file owned by pulse-team-daemon. Personal COHERE_API_KEY and ~/.pulse are
# deliberately ignored in team-remote mode.
PULSE_TEAM_COHERE_KEY_FILE=/etc/pulse-team/secrets/team-cohere-key.txt

# Local alternative: unset PULSE_TEAM_COHERE_KEY_FILE and set all three exact
# absolute paths. Partial configuration fails startup.
# PULSE_TEAM_LOCAL_EMBED_PYTHON=/opt/pulse-team/dependencies/python
# PULSE_TEAM_LOCAL_EMBED_HELPER=/opt/pulse-team/dependencies/team-embed-helper.py
# PULSE_TEAM_LOCAL_EMBED_MODEL=/opt/pulse-team/models/bge-m3

# Synthetic Airlock target. The candidate must be a canonical, labeled
# synthetic envelope, mode 0600, owned by pulse-team-daemon, and bound to the
# exact pinned store/team. This does not authorize real publication.
PULSE_TEAM_PUBLICATION_DEPLOYMENT_ID=deployment_SYNTHETIC_PLACEHOLDER
PULSE_TEAM_SHARED_PROJECT_ID=project_SYNTHETIC_PLACEHOLDER
PULSE_TEAM_AIRLOCK_ORIGIN=https://pulse-team.synthetic.invalid
PULSE_TEAM_AIRLOCK_SYNTHETIC_CANDIDATE_FILE=/etc/pulse-team/synthetic/airlock-candidate.json
PULSE_TEAM_PUBLICATION_SYNTHETIC_ONLY=1

# Leave unset for the normal daemon. A temporary root-owned systemd drop-in may
# set this to 1 only for the documented Owner bootstrap/activation ceremony.
# PULSE_TEAM_OWNER_ADMIN_ONLY=1

# ---------------------------------------------------------------------------
# /etc/pulse-team/gateway.env (0640 root:pulse-team-gateway)
# ---------------------------------------------------------------------------

PULSE_BASE_URL=http://127.0.0.1:18789
PULSE_MCP_HOST=127.0.0.1
PULSE_MCP_PORT=8787
PULSE_MCP_TRANSPORT=streamable-http

# Auth0 mapping:
#   issuer         = the exact Auth0 tenant/custom-domain issuer
#   API Identifier = PULSE_REMOTE_PUBLIC_BASE_URL + /mcp
# Configure Auth0 access tokens as RS256, audience-bound to that identifier,
# with lifetime <= 900 seconds and only Pulse's declared team scopes.
PULSE_REMOTE_PUBLIC_BASE_URL=https://pulse-team.synthetic.invalid
PULSE_REMOTE_AUTH_ISSUER=https://YOUR_AUTH0_TENANT.auth0.com/
PULSE_REMOTE_ALLOWED_ORIGINS=https://pulse-team.synthetic.invalid
PULSE_REMOTE_MAX_TOKEN_LIFETIME_SECONDS=900
PULSE_REMOTE_OWNER_MAX_AUTH_AGE_SECONDS=300
# Operator-managed pulse.team.installation_enrollment_registry.v1. Install as a
# regular, non-symlink file owned by the gateway uid with no group/other bits.
PULSE_REMOTE_ENROLLMENT_REGISTRY_FILE=/etc/pulse-team/installation-enrollments.json

# Required together for the separate Owner publication Airlock. The client is
# public Authorization Code + PKCE and must receive openid pulse:owner. The
# authorization server must satisfy the exact platform-WebAuthn ACR/claim
# contract in deploy/team/README.md; these endpoints must share the issuer
# origin and redirects are rejected.
PULSE_TEAM_AIRLOCK_OIDC_CLIENT_ID=AUTH0_AIRLOCK_OWNER_CLIENT_ID_PLACEHOLDER
PULSE_TEAM_AIRLOCK_OIDC_AUTHORIZATION_ENDPOINT=https://YOUR_AUTH0_TENANT.auth0.com/authorize
PULSE_TEAM_AIRLOCK_OIDC_TOKEN_ENDPOINT=https://YOUR_AUTH0_TENANT.auth0.com/oauth/token

# These must match the daemon pins and the assertion key material installed via
# systemd credentials. Key file paths are supplied by the service unit.
PULSE_TEAM_PRINCIPAL_SIGNING_KID=SYNTHETIC_GATEWAY_KID_PLACEHOLDER
PULSE_TEAM_EXPECTED_STORE_ID=store_SYNTHETIC_PLACEHOLDER
PULSE_TEAM_EXPECTED_TEAM_ID=team_SYNTHETIC_PLACEHOLDER

# Fail-closed settings. The current binary rejects public activation in
# team-remote mode; these values document that boundary and must remain false.
PULSE_TEAM_REMOTE_ACTIVATED=0
PULSE_REMOTE_OAUTH_DEV=0
PULSE_REMOTE_AUTH_PROXY_MODE=0
PULSE_REMOTE_TRUST_AUTH_HEADER=0
PULSE_REMOTE_ALLOW_UNAUTHENTICATED=0
PULSE_ALLOW_AUTHLESS_PUBLIC=0
PULSE_REMOTE_BEARER=
