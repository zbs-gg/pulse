{
  "hooks": {
    "UserPromptSubmit": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "exec \"$HOME/.local/bin/pulse\" product-hook UserPromptSubmit",
            "timeout": 30
          }
        ]
      }
    ],
    "PreToolUse": [
      {
        "matcher": "mcp__pulse__pulse_memory|mcp__pulse-product__pulse_memory|mcp__plugin_pulse_pulse-product__pulse_memory",
        "hooks": [
          {
            "type": "command",
            "command": "exec \"$HOME/.local/bin/pulse\" product-hook PreToolUse",
            "timeout": 10
          }
        ]
      }
    ],
    "PostToolUse": [
      {
        "matcher": "mcp__pulse__pulse_memory|mcp__pulse-product__pulse_memory|mcp__plugin_pulse_pulse-product__pulse_memory",
        "hooks": [
          {
            "type": "command",
            "command": "exec \"$HOME/.local/bin/pulse\" product-hook PostToolUse",
            "timeout": 10
          }
        ]
      }
    ]
  }
}
