{
  "hooks": {
    "UserPromptSubmit": [
      {
        "hooks": [
          { "type": "command", "command": "node", "args": ["${CLAUDE_PLUGIN_ROOT}/hooks/claude-hook.mjs", "UserPromptSubmit"], "timeout": 30 }
        ]
      }
    ],
    "PreToolUse": [
      {
        "matcher": "mcp__pulse-product__pulse_memory|mcp__plugin_pulse_pulse-product__pulse_memory",
        "hooks": [
          { "type": "command", "command": "node", "args": ["${CLAUDE_PLUGIN_ROOT}/hooks/claude-hook.mjs", "PreToolUse"], "timeout": 10 }
        ]
      }
    ],
    "PostToolUse": [
      {
        "matcher": "mcp__pulse-product__pulse_memory|mcp__plugin_pulse_pulse-product__pulse_memory",
        "hooks": [
          { "type": "command", "command": "node", "args": ["${CLAUDE_PLUGIN_ROOT}/hooks/claude-hook.mjs", "PostToolUse"], "timeout": 10 }
        ]
      }
    ]
  }
}
